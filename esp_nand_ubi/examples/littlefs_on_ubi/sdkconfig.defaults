CONFIG_NAND_FLASH_ENABLE_BDL=y
CONFIG_ESP_NAND_UBI_ENABLE=y
# joltwallet/littlefs requires a per-file cache >= the NAND page size, or
# mount fails with "No valid cache_size <= ... for block=...".
CONFIG_LITTLEFS_CACHE_SIZE=4096
# esp_nand_ubi has no wear-leveling yet (Phase 1 is passive/lowest-EC-free-PEB
# only); disable LittleFS's own metadata block-cycling so there is exactly one
# wear-leveling decision-maker instead of two disagreeing ones. Revisit once
# esp_nand_ubi's Phase 4 background WL task lands.
CONFIG_LITTLEFS_BLOCK_CYCLES=-1
