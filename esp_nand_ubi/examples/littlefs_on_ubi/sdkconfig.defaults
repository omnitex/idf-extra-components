CONFIG_NAND_FLASH_ENABLE_BDL=y
CONFIG_ESP_NAND_UBI_ENABLE=y
# joltwallet/littlefs requires a per-file cache >= the NAND page size, or
# mount fails with "No valid cache_size <= ... for block=...".
CONFIG_LITTLEFS_CACHE_SIZE=4096
# CONFIG_LITTLEFS_BLOCK_CYCLES intentionally left at joltwallet's default
# (512): esp_nand_ubi has no wear-leveling yet (Phase 1's free-PEB allocator
# is a plain first-fit scan, not even EC-based), so littlefs's own metadata-
# pair relocation is the only active wear-spreading mechanism in this whole
# stack right now. Disabling it would pin the hottest LEB (littlefs's
# superblock/root metadata, rewritten on every directory change) to whatever
# PEB UBI's first-fit allocator keeps handing back, with nothing to counter
# the concentration. block_cycles only relocates the metadata pair, not
# regular file data blocks (those are already spread by littlefs's own
# free-block allocator) -- so it shouldn't meaningfully conflict with
# esp_nand_ubi's Phase 4 background WL once that lands, since the two operate
# on different address ranges. Revisit only if hardware profiling shows
# otherwise.
