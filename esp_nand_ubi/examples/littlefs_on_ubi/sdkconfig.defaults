CONFIG_NAND_FLASH_ENABLE_BDL=y
CONFIG_ESP_NAND_UBI_ENABLE=y
# joltwallet/littlefs requires a per-file cache >= the NAND page size, or
# mount fails with "No valid cache_size <= ... for block=...".
CONFIG_LITTLEFS_CACHE_SIZE=4096
# Feed the task watchdog from inside littlefs_bdl.c's read/write/erase/sync
# calls. Without this, a long attach scan or a format that erases many PEBs
# back-to-back can starve CPU0's idle task long enough to trip the interrupt
# watchdog (observed as "Guru Meditation Error: ... Interrupt wdt timeout").
CONFIG_LITTLEFS_WDT_RESET=y
# CONFIG_LITTLEFS_BLOCK_CYCLES intentionally left at joltwallet's default
# (512): esp_nand_ubi allocates the least-erased of a few randomly sampled
# free PEBs (CONFIG_ESP_NAND_UBI_ALLOC_SAMPLES) but does not yet move data
# that stays put, so littlefs's own metadata-pair relocation is kept as a
# second mechanism for the hottest LEB (littlefs's superblock/root metadata,
# rewritten on every directory change). block_cycles only relocates the metadata pair, not
# regular file data blocks (those are already spread by littlefs's own
# free-block allocator) -- so it shouldn't meaningfully conflict with
# esp_nand_ubi's Phase 4 background WL once that lands, since the two operate
# on different address ranges. Revisit only if hardware profiling shows
# otherwise.
